# ============================================================
# Generate unique passwords/secrets before using it.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL (used by deployments/docker-compose.yml)
# ------------------------------------------------------------
POSTGRES_DB=mailforge
POSTGRES_USER=mailforge
# Use: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_48_HEX_CHAR_POSTGRES_PASSWORD

# Host-side port from deployments/docker-compose.yml: 127.0.0.1:5434 -> 5432
# Hex password avoids URL-escaping special characters.
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5434/${POSTGRES_DB}?sslmode=disable"

# ------------------------------------------------------------
# Redis (used by deployments/docker-compose.yml)
# ------------------------------------------------------------
# Use: openssl rand -hex 24
REDIS_PASSWORD=REPLACE_WITH_48_HEX_CHAR_REDIS_PASSWORD
REDIS_ADDR=127.0.0.1:6379

# ------------------------------------------------------------
# Local SMTP test relay - Mailpit
# ------------------------------------------------------------
# deployments/docker-compose.yml exposes Mailpit on 127.0.0.1:1025
# This plaintext mode is ONLY for the local Mailpit development relay.
SMTP_RELAY_HOST=127.0.0.1
SMTP_RELAY_PORT=1025
SMTP_RELAY_TLS_MODE=none
SMTP_REQUIRE_STARTTLS=false
SMTP_EHLO_NAME=localhost

# For production, remove SMTP_RELAY_HOST/PORT/TLS_MODE to use direct MX,
# or configure your trusted relay with TLS, for example:
# SMTP_RELAY_HOST=smtp-relay.provider.example
# SMTP_RELAY_PORT=587
# SMTP_RELAY_TLS_MODE=required-starttls
# SMTP_REQUIRE_STARTTLS=true
# SMTP_EHLO_NAME=mail.example.com

# ------------------------------------------------------------
# Authenticated SMTP submission server
# ------------------------------------------------------------
# The server requires a certificate and private key even in local dev.
# Create ./secrets and place a certificate/key pair there.
SMTP_SUBMISSION_ADDR=127.0.0.1:1587
SMTP_TLS_CERT_FILE=./secrets/smtp-cert.pem
SMTP_TLS_KEY_FILE=./secrets/smtp-key.pem

# SMTP submission resource limits
SMTP_MAX_CONNECTIONS=100
SMTP_MAX_RECIPIENTS=100
SMTP_MAX_CONCURRENT_AUTH=10
SMTP_MAX_CONCURRENT_DATA=10

# Redis-backed distributed AUTH rate limits (shared by all submission replicas)
SMTP_AUTH_ATTEMPTS_PER_IP=100
SMTP_AUTH_ATTEMPTS_PER_USERNAME=30
SMTP_AUTH_WINDOW_SECONDS=300
SMTP_AUTH_RATE_LIMIT_PREFIX=mailforge:smtp:auth:v1

# Transactional submission quotas
SMTP_MAX_SUBMISSIONS_PER_ACCOUNT_PER_HOUR=1000
SMTP_MAX_SUBMISSIONS_PER_IP_PER_HOUR=5000
SMTP_MAX_RECIPIENTS_PER_ACCOUNT_PER_HOUR=10000
SMTP_MAX_RECIPIENTS_PER_IP_PER_HOUR=50000

# Prometheus metrics for SMTP submission
SUBMISSION_METRICS_ADDR=127.0.0.1:9095

# ------------------------------------------------------------
# SMTP credentials for loadtest / delivery-benchmark tools
# These are NOT the SMTP server's TLS credentials.
# Create the account with cmd/smtp-user; then use its credentials here.
# ------------------------------------------------------------
SMTP_USERNAME=local-test-user
SMTP_PASSWORD=REPLACE_WITH_THE_SMTP_ACCOUNT_PASSWORD
SMTP_FROM=sender@example.com
# Optional CA bundle for a locally trusted/self-signed SMTP certificate.
# Leave blank if the submission certificate chains to a trusted CA.
SMTP_TLS_CA_FILE=./secrets/local-ca.pem

# ------------------------------------------------------------
# Delivery worker
# ------------------------------------------------------------
DELIVERY_WORKER_CONCURRENCY=3
SMTP_CONNECT_TIMEOUT=15s
SMTP_OPERATION_TIMEOUT=30s
SMTP_DELIVERY_TIMEOUT=2m

# Retry policy
DELIVERY_RETRY_INITIAL_DELAY=30m
DELIVERY_RETRY_MAX_DELAY=3h
DELIVERY_RETRY_MAX_QUEUE_AGE=120h
DELIVERY_RETRY_MAX_ATTEMPTS=100

# Worker Prometheus metrics
# cmd/delivery-worker defaults to 127.0.0.1:9091.
# cmd/smtp defaults to 127.0.0.1:9090.
# Both binaries currently share the METRICS_ADDR variable name, so override
# per process on the command line if you need custom addresses.

# ------------------------------------------------------------
# DKIM signing (recommended: hot-reloadable keyset manifest)
# Create ./secrets/dkim-keyset.json and the private key files first.
# The worker polls the manifest every 5 seconds and keeps the last-known-good
# signer if a changed manifest is invalid.
# ------------------------------------------------------------
SMTP_DKIM_KEYSET_FILE=./secrets/dkim-keyset.json

# Do NOT set the legacy single-key trio together with SMTP_DKIM_KEYSET_FILE.
# Legacy alternative, only when NOT using the keyset manifest:
# SMTP_DKIM_DOMAIN=example.com
# SMTP_DKIM_SELECTOR=mf-2026-02
# SMTP_DKIM_PRIVATE_KEY_FILE=./secrets/dkim-mf-2026-02.pem

# ------------------------------------------------------------
# VERP bounce generation + inbound DSN receiver
# Use the SAME domain and HMAC secret in every delivery worker and the
# smtp-bounce receiver. Keep the HMAC secret stable while outstanding VERP
# addresses may still receive DSNs.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------
SMTP_BOUNCE_DOMAIN=bounces.example.com
SMTP_BOUNCE_HMAC_SECRET=REPLACE_WITH_64_HEX_CHAR_BOUNCE_HMAC_SECRET

# Dedicated inbound DSN receiver (loopback-only local development default)
SMTP_BOUNCE_LISTEN_ADDR=127.0.0.1:2526
SMTP_BOUNCE_HOSTNAME=localhost
SMTP_BOUNCE_MAX_CONNECTIONS=100
SMTP_BOUNCE_PROCESS_TIMEOUT=20s

# Optional inbound receiver TLS. Set BOTH files together for direct TLS-enabled
# inbound service. For local development behind loopback, leave commented.
# SMTP_BOUNCE_TLS_CERT_FILE=./secrets/bounce-cert.pem
# SMTP_BOUNCE_TLS_KEY_FILE=./secrets/bounce-key.pem

# ------------------------------------------------------------
# Local SMTP server (unauthenticated, loopback-only)
# ------------------------------------------------------------
# cmd/smtp uses fixed loopback listener 127.0.0.1:2525.
# Its metrics default is 127.0.0.1:9090. The delivery worker's metrics
# default is 127.0.0.1:9091. Do not set one shared METRICS_ADDR for both.

# ------------------------------------------------------------
# Outbox publisher
# ------------------------------------------------------------
OUTBOX_PUBLISH_BATCH_SIZE=50
OUTBOX_METRICS_ADDR=127.0.0.1:9096

# Optional actor label for cmd/outbox-admin replay operations
OUTBOX_REPLAYED_BY=local-operator

# ------------------------------------------------------------
# Test-only integrations (leave commented unless using dedicated test data)
# NEVER point integration tests at production databases or Redis.
# ------------------------------------------------------------
# Dedicated disposable PostgreSQL database for integration tests:
# MAILFORGE_TEST_DATABASE_URL=postgres://mailforge_test:TEST_PASSWORD@127.0.0.1:5434/mailforge_test?sslmode=disable
# Dedicated Redis test instance (the rate-limiter integration test uses DB 15):
# REDIS_TEST_ADDR=127.0.0.1:6379
# REDIS_TEST_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# Delivery integration test Redis settings:
# MAILFORGE_TEST_REDIS_ADDR=127.0.0.1:6379
# MAILFORGE_TEST_REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# MAILFORGE_TEST_REDIS_DB=15
