    {
      "id": 5,
      "type": "timeseries",
      "title": "SMTP message acceptance rate",
      "description": "Compares the inbound SMTP listener (port 2525) with authenticated submission (port 587).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(mailforge_smtp_messages_accepted_total{job=~\"mailforge-smtp|mailforge-smtp-submission\"}[5m]))",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "legendFormat": "Accepted \u00b7 {{job}}"
        },
        {
          "refId": "B",
          "expr": "sum by (job) (rate(mailforge_smtp_messages_rejected_total{job=~\"mailforge-smtp|mailforge-smtp-submission\"}[5m]))",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "legendFormat": "Rejected \u00b7 {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
