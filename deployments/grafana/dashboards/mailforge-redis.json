    {
      "id": 8,
      "type": "gauge",
      "title": "Keyspace Hit Ratio",
      "description": "Share of key lookups served from Redis keyspace. Meaningful after traffic is present.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(redis_keyspace_hits_total{job=\"mailforge-redis\"}[5m])) / clamp_min(sum(rate(redis_keyspace_hits_total{job=\"mailforge-redis\"}[5m])) + sum(rate(redis_keyspace_misses_total{job=\"mailforge-redis\"}[5m])), 1e-9)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
